{
  "name": "BlockCraft",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "NoLoadingScreen": {
        "$path": "src/first/NoLoadingScreen.client.luau"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "LockFirstPerson",
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 4.2,
        "CharacterWalkSpeed": 13,
        "EnableMouseLockOption": false,
        "GameSettingsAvatar": "R6"
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "Health": {
          "$path": "src/character/Health.server.luau"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "TextChatService": {
      "$properties": {
        "ChatVersion": "TextChatService",
        "CreateDefaultCommands": false
      }
    },
    "Lighting": {
      "$properties": {
        "Brightness": 2.5,
        "GlobalShadows": true,
        "Ambient": [0.35, 0.35, 0.38],
        "OutdoorAmbient": [0.55, 0.55, 0.6],
        "ClockTime": 8
      }
    }
  }
}
